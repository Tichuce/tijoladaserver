<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Browser client helper: converts the Aspereta game data into browser assets (convert)
    and serves the browser client locally (serve). Not part of the game server.

    The decoders are the desktop client's own source files, compiled in unchanged, so the
    browser sees exactly what the desktop client decodes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>AsperetaWeb</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The linked client files predate nullable annotations and use a few obsolete-style patterns. -->
    <NoWarn>$(NoWarn);CS8632;CS0168;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same SQLite package and version as the game server (wiki export). -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../gooseclient/AsperetaClient/AdfFile.cs" Link="Client/AdfFile.cs" />
    <Compile Include="../../../gooseclient/AsperetaClient/CompiledEnc.cs" Link="Client/CompiledEnc.cs" />
    <Compile Include="../../../gooseclient/AsperetaClient/MapFile.cs" Link="Client/MapFile.cs" />
    <Compile Include="../../../gooseclient/AsperetaClient/AsperetaMapLoader.cs" Link="Client/AsperetaMapLoader.cs" />
    <Compile Include="../../../gooseclient/AsperetaClient/IniFile.cs" Link="Client/IniFile.cs" />
  </ItemGroup>
</Project>
